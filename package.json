{
  "name": "@gym/backend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "catalog:import": "node --require ./scripts/tsx-windows-userinfo-compat.cjs ./node_modules/tsx/dist/cli.mjs scripts/import-repdb.ts",
    "catalog:openapi": "node --require ./scripts/tsx-windows-userinfo-compat.cjs ./node_modules/tsx/dist/cli.mjs scripts/generate-catalog-openapi.ts",
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed:local-login": "node scripts/set-local-test-password.cjs",
    "db:seed:local-generation-catalog": "node scripts/seed-local-generation-catalog.cjs",
    "db:seed:local-catalog-media": "node scripts/set-local-catalog-media.cjs",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "dev": "node --require ./scripts/tsx-windows-userinfo-compat.cjs ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.0.0",
    "fflate": "0.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
