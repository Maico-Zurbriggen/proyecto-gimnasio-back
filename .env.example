NODE_ENV=development
API_PORT=3000
# Lista separada por comas, sin barras finales.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL local: iniciar con `docker compose -f compose.local.yaml up -d --wait`.
LOCAL_DATABASE_PORT=55432
DATABASE_URL=postgresql://gym_migrator@127.0.0.1:55432/gym_local?schema=public
LOCAL_GENERATION_TESTING=true

# API FastAPI local. En Vercel se configura la URL del servicio desplegado.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=
AI_SERVICE_REQUEST_TIMEOUT_MS=10000
AI_SERVICE_MAX_RETRIES=1
AI_RESULT_RETENTION_DAYS=30

# Protege la invocación del job diario de controles de mediciones.
CRON_SECRET=

# HU09/HU13: envío transaccional por la API HTTP de Brevo. El remitente debe
# existir y estar verificado en Brevo; `BREVO_SENDER_NAME` es opcional.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vivaz
RECOVERY_PAGE_URL=http://localhost:5173/recuperar-contrasena

# HU13: invitación de arranque del primer administrador. El enlace es
# `<INVITATION_PAGE_URL>/<token>`. En desarrollo, sin configuración de Brevo,
# el enlace se escribe en la consola.
INVITATION_PAGE_URL=http://localhost:5173/invitacion
# 0 local. En despliegue, cantidad exacta de proxies confiables delante de Express.
TRUST_PROXY_HOPS=0

# Private importer data and persistent media directory; never commit either.
CATALOG_PRIVATE_DIR=.catalog-private
CATALOG_ASSETS_DIR=.catalog-private/assets
# Optional own HTTPS CDN, after uploading the versioned assets. Default: authenticated /catalog/media.
CATALOG_MEDIA_BASE_URL=
