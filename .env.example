NODE_ENV=development
API_PORT=3000
# Lista separada por comas, sin barras finales.
CORS_ORIGINS=http://localhost:5173

# PostgreSQL local: iniciar con `docker compose -f compose.local.yaml up -d --wait`.
LOCAL_DATABASE_PORT=55432
DATABASE_URL=postgresql://gym_migrator@127.0.0.1:55432/gym_local?schema=public
LOCAL_GENERATION_TESTING=true

# API FastAPI local. En Vercel se configura la URL del servicio desplegado.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=
AI_SERVICE_REQUEST_TIMEOUT_MS=10000
AI_SERVICE_MAX_RETRIES=1
AI_RESULT_RETENTION_DAYS=30

# Protege la invocación del job diario de controles de mediciones.
CRON_SECRET=
